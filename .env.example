# GHKGE Environment Configuration
# Copy to .env and fill in your values

# Postgres (Supabase)
GHKGE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ghkge

# Neo4j
GHKGE_NEO4J_URI=bolt://localhost:7687
GHKGE_NEO4J_USER=neo4j
GHKGE_NEO4J_PASSWORD=password

# LLM (OpenRouter or direct provider)
GHKGE_OPENAI_API_KEY=your-api-key-here
GHKGE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
GHKGE_EXTRACTION_MODEL=google/gemini-flash-2.0

# Embeddings (Ollama)
GHKGE_OLLAMA_BASE_URL=http://localhost:11434
GHKGE_EMBEDDING_MODEL=nomic-embed-text
