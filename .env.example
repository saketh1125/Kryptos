# GHKGE Environment Configuration
# Copy to .env and fill in your values. Every variable is optional — the engine
# boots with defaults, but live crawling/consolidation needs the services below.

# --- Postgres (Supabase) -------------------------------------------------
# System of record: runs, captures, entities, facts, gaps, task bus, feedback.
GHKGE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ghkge

# --- Neo4j (AuraDB free tier) -------------------------------------------
# Entity graph: traversal for the /nearby endpoint.
GHKGE_NEO4J_URI=bolt://localhost:7687
GHKGE_NEO4J_USER=neo4j
GHKGE_NEO4J_PASSWORD=password

# --- LLM (OpenRouter or direct provider) --------------------------------
# Powers fact extraction (instructor + Pydantic validation).
GHKGE_OPENAI_API_KEY=your-api-key-here
GHKGE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
GHKGE_EXTRACTION_MODEL=google/gemini-flash-2.0
GHKGE_PLANNER_MODEL=google/gemini-flash-2.0

# --- Embeddings (Ollama) -------------------------------------------------
# Local embeddings into pgvector. Must match GHKGE_EMBEDDING_DIM.
GHKGE_OLLAMA_BASE_URL=http://localhost:11434
GHKGE_EMBEDDING_MODEL=nomic-embed-text
GHKGE_EMBEDDING_DIM=768

# --- Domain configuration ------------------------------------------------
# Ontology, bbox, strategies, and public seed URLs. This is the file that
# makes the engine domain-agnostic — a new city is a new YAML, not new code.
GHKGE_DOMAIN_CONFIG_PATH=config/default_domain.yaml
GHKGE_GRID_PRECISION=6

# --- Compliance ----------------------------------------------------------
# Sent as User-Agent and rate limit is enforced per domain.
GHKGE_USER_AGENT=HyperlocalKnowledgeGraphEngine/1.0 (+https://github.com/saketh1125/Kryptos)
GHKGE_RATE_LIMIT_INTERVAL_S=2.0
GHKGE_ROBOTS_CACHE_TTL_HOURS=24

# --- Harvesting ----------------------------------------------------------
GHKGE_MAX_CONCURRENT_BROWSERS=3
GHKGE_MAX_CONCURRENT_DOC_PARSERS=1
GHKGE_CHUNK_SIZE_WORDS=800
GHKGE_CHUNK_OVERLAP_WORDS=150

# --- Entity resolution ---------------------------------------------------
# RapidFuzz token_sort_ratio merge threshold, and the safety corroboration bar.
GHKGE_ENTITY_MATCH_THRESHOLD=85
GHKGE_SAFETY_CORROBORATION_MIN=2

# --- Workers (task bus polling) ------------------------------------------
GHKGE_WORKERS_ENABLED=true
GHKGE_WORKER_POLL_INTERVAL_S=1.0
GHKGE_WORKER_BATCH_SIZE=5
GHKGE_STALE_TASK_TAKEOVER_MINUTES=10

# --- Scheduler (APScheduler) ---------------------------------------------
# Gap evaluation runs by default; unattended acquisition is opt-in.
GHKGE_SCHEDULER_ENABLED=true
GHKGE_GAP_EVAL_INTERVAL_HOURS=24
GHKGE_GAP_STALE_AFTER_MINUTES=30
GHKGE_SCHEDULED_ACQUISITION_ENABLED=false
GHKGE_ACQUISITION_INTERVAL_HOURS=24
GHKGE_SCHEDULER_DEFAULT_DOMAIN=example_hyperlocal_domain

# --- API -----------------------------------------------------------------
# Set JSON_LOGGING=true when shipping logs to an aggregator.
GHKGE_JSON_LOGGING=false
GHKGE_API_HOST=0.0.0.0
GHKGE_API_PORT=8000
